# Copy to deploy/.env and adjust for this host. deploy/.env is read
# automatically by `docker compose -f deploy/docker-compose.yml ...` — no
# --env-file flag needed. Never commit the real deploy/.env: it is
# host-specific (a shared dev box and the production host will want different
# values here), which is why it is gitignored and this file is the template.

# Host interface both containers bind to. 127.0.0.1 is correct when a tunnel
# or reverse proxy on this same machine terminates TLS. Set to 0.0.0.0 only
# when Cloudflare (or another forwarding layer) reaches this host directly on
# the ports below, and only behind a firewall that restricts who can connect.
OAM_BIND=127.0.0.1

# Host ports. Change these if they collide with something already running on
# this host — check `docker ps` / Portainer first. Both must stay on
# Cloudflare's supported proxy-port list if you expose them through
# Cloudflare's proxy without a tunnel: see deploy/README.md, "Behind
# Cloudflare".
OAM_SITE_PORT=2086
OAM_MCP_PORT=8880
